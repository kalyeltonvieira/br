explicacao
    Backup DB: Backup e restauração de bancos.
    Este módulo permite fazer backup e restauração de bancos de dados.
    Esta biblioteca é totalmente funcional e nativa.
fim

função nome
    devolva "backup_db"
fim

função descricao
    devolva "Backup e restauração de bancos"
fim

função versao
    devolva "1.0.0"
fim

# ============ BACKUP SQLITE ============

função backup_sqlite recebendo caminho_origem e caminho_destino
    # Faz backup de um banco SQLite
    resultado é servico_backup("backup_sqlite", caminho_origem, caminho_destino)
    devolva resultado
fim

função restaurar_sqlite recebendo caminho_origem e caminho_destino
    # Restaura um banco SQLite
    resultado é servico_backup("restaurar_sqlite", caminho_origem, caminho_destino)
    devolva resultado
fim

