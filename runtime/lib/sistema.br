explicacao
    Sistema: informações do sistema operacional, processos, ambiente,
    usuário, memória, disco, rede e utilitários de sistema.
    Biblioteca padrão da linguagem BR.
fim

função nome
    devolva "sistema"
fim

função descricao
    devolva "Sistema: SO, processos, ambiente, usuário e utilitários"
fim

função versao
    devolva "1.0.0"
fim

# ============ SISTEMA OPERACIONAL ============

função so_nome
    importar "arquivo" as arq
    tente
        se arq.existe("C:") então
            devolva "Windows"
        senao
            devolva "Linux"
        fim
    capture erro
        devolva "Desconhecido"
    fim
fim

função so_versao
    devolva servico_sistema("so_versao")
fim

função so_arquitetura
    devolva servico_sistema("so_arquitetura")
fim

função hostname
    devolva servico_sistema("hostname")
fim

função nome_usuario
    devolva servico_sistema("nome_usuario")
fim

função diretorio_usuario
    devolva servico_sistema("diretorio_usuario")
fim

função diretorio_atual
    devolva servico_sistema("diretorio_atual")
fim

função diretorio_temporario
    devolva servico_sistema("diretorio_temporario")
fim

