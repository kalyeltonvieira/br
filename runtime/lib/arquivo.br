# ============ CAMINHOS ============

função juntar recebendo partes
    importar "texto" as txt
    resultado é ""
    primeira é verdadeiro
    
    para cada parte em partes
        se vazio(parte) então
            continue
        fim
        
        se primeira então
            resultado é parte
            primeira é falso
        senao
            # Garantir apenas um separador
            se not txt.termina_com(resultado, "/") e not txt.termina_com(resultado, "\\") então
                resultado é resultado + "/"
            fim
            se txt.comeca_com(parte, "/") ou txt.comeca_com(parte, "\\") então
                parte é parte[1:]
            fim
            resultado é resultado + parte
        fim
    fim
    
    devolva resultado
fim

função diretorio_pai recebendo caminho
    importar "texto" as txt
    
    # Remover separador do final
    enquanto txt.termina_com(caminho, "/") ou txt.termina_com(caminho, "\\")
        caminho é caminho[0:tamanho(caminho)-1]
    fim
    
    pos_barra é txt.encontrar_ultimo(caminho, "/")
    pos_contra_barra é txt.encontrar_ultimo(caminho, "\\")
    
    pos é pos_barra se pos_barra > pos_contra_barra senao pos_contra_barra
    se pos < 0 então
        devolva ""
    fim
    
    devolva caminho[0:pos]
fim

função nome_arquivo recebendo caminho
    importar "texto" as txt
    
    caminho_limpo é caminho
    enquanto txt.termina_com(caminho_limpo, "/") ou txt.termina_com(caminho_limpo, "\\")
        caminho_limpo é caminho_limpo[0:tamanho(caminho_limpo)-1]
    fim
    
    pos_barra é txt.encontrar_ultimo(caminho_limpo, "/")
    pos_contra_barra é txt.encontrar_ultimo(caminho_limpo, "\\")
    
    pos é pos_barra se pos_barra > pos_contra_barra senao pos_contra_barra
    se pos < 0 então
        devolva caminho_limpo
    fim
    
    devolva caminho_limpo[pos+1:]
fim

função extensao recebendo caminho
    importar "texto" as txt
    nome é nome_arquivo(caminho)
    pos_ponto é txt.encontrar_ultimo(nome, ".")
    se pos_ponto < 0 então
        devolva ""
    fim
    devolva nome[pos_ponto:]
fim

função sem_extensao recebendo caminho
    importar "texto" as txt
    nome é nome_arquivo(caminho)
    pos_ponto é txt.encontrar_ultimo(nome, ".")
    se pos_ponto < 0 então
        devolva nome
    fim
    devolva nome[0:pos_ponto]
fim

função caminho_absoluto recebendo caminho
    devolva servico_nativo("ARQUIVOS", "CAMINHO_ABSOLUTO", caminho)
fim

