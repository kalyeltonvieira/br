explicacao
    Arquivo: manipulação completa de arquivos e diretórios.
    Leitura, escrita, cópia, movimentação, listagem, permissões,
    formatações suportadas: texto, JSON, CSV, binário.
    Biblioteca padrão da linguagem BR.
fim

função nome
    devolva "arquivo"
fim

função descricao
    devolva "Arquivo: manipulação completa de arquivos e diretórios"
fim

função versao
    devolva "1.0.0"
fim

# ============ LEITURA ============

função ler recebendo caminho
    devolva servico_nativo("ARQUIVOS", "LER", caminho)
fim

função ler_texto recebendo caminho
    tente
        conteudo é ler(caminho)
        devolva conteudo
    capture erro
        devolva ""
    fim
fim

função ler_linhas recebendo caminho
    tente
        conteudo é ler(caminho)
        importar "texto" as txt
        devolva txt.dividir_linhas(conteudo)
    capture erro
        devolva []
    fim
fim

função ler_json recebendo caminho
    importar "json" as json
    tente
        conteudo é ler(caminho)
        devolva json.parsear(conteudo)
    capture erro
        devolva nulo
    fim
fim

função ler_csv recebendo caminho
    importar "csv" as csv
    tente
        conteudo é ler(caminho)
        devolva csv.ler(conteudo)
    capture erro
        devolva []
    fim
fim

função ler_csv_com_cabecalho recebendo caminho
    importar "csv" as csv
    tente
        conteudo é ler(caminho)
        devolva csv.ler_com_cabecalho(conteudo)
    capture erro
        devolva []
    fim
fim

# ============ ESCRITA ============

função escrever recebendo caminho e conteudo
    tente
        servico_nativo("ARQUIVOS", "ESCREVER", caminho, "" + conteudo)
        devolva verdadeiro
    capture erro
        devolva falso
    fim
fim

função escrever_linhas recebendo caminho e linhas
    resultado é ""
    primeira é verdadeiro
    para cada linha em linhas
        se não primeira então
            resultado é resultado + "\n"
        senao
            primeira é falso
        fim
        resultado é resultado + linha
    fim
    devolva escrever(caminho, resultado)
fim

função escrever_json recebendo caminho e dados
    importar "json" as json
    tente
        texto_json é json.bonito(dados)
        devolva escrever(caminho, texto_json)
    capture erro
        devolva falso
    fim
fim

função escrever_csv recebendo caminho e dados
    importar "csv" as csv_mod
    tente
        texto_csv é csv_mod.escrever(dados)
        devolva escrever(caminho, texto_csv)
    capture erro
        devolva falso
    fim
fim

função anexar recebendo caminho e conteudo
    devolva servico_nativo("ARQUIVOS", "ANEXAR", caminho, conteudo)
fim

função anexar_linha recebendo caminho e linha
    devolva anexar(caminho, linha + "\n")
fim

