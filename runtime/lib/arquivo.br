# ============ TESTES ============

teste "caminhos - nome arquivo"
    resultado é nome_arquivo("/home/usuario/arquivo.txt")
    esporte resultado igual a "arquivo.txt"
fim

teste "caminhos - extensao"
    resultado é extensao("documento.pdf")
    esporte resultado igual a ".pdf"
fim

teste "caminhos - diretorio pai"
    resultado é diretorio_pai("/home/usuario/arquivo.txt")
    esporte resultado igual a "/home/usuario"
fim

teste "caminhos - juntar"
    resultado é juntar(["/home", "usuario", "arquivo.txt"])
    esporte resultado igual a "/home/usuario/arquivo.txt"
fim

teste "caminhos - sem extensao"
    resultado é sem_extensao("arquivo.txt")
    esporte resultado igual a "arquivo"
fim