função criar_diretorio recebendo caminho
    devolva servico_nativo("ARQUIVOS", "CRIAR_DIRETORIO", caminho)
fim

função criar_diretorios recebendo caminho
    devolva servico_nativo("ARQUIVOS", "CRIAR_DIRETORIOS", caminho)
fim

função listar recebendo caminho
    devolva servico_nativo("ARQUIVOS", "LISTAR", caminho)
fim

função listar_arquivos recebendo caminho
    todos é listar(caminho)
    resultado é []
    para cada item em todos
        se eh_arquivo(juntar(caminho, item)) então
            adicione item a resultado
        fim
    fim
    devolva resultado
fim

função listar_diretorios recebendo caminho
    todos é listar(caminho)
    resultado é []
    para cada item em todos
        se eh_diretorio(juntar(caminho, item)) então
            adicione item a resultado
        fim
    fim
    devolva resultado
fim

função listar_recursivo recebendo caminho
    resultado é []
    _listar_rec(caminho, "", resultado)
    devolva resultado
fim

função _listar_rec recebendo base, relativo, resultado
    atual é base se relativo "" senao juntar(base, relativo)
    itens é listar(atual)
    
    para cada item em itens
        caminho_item é relativo se relativo "" senao relativo + "/" + item
        adicione caminho_item a resultado
        caminho_completo é juntar(base, caminho_item)
        se eh_diretorio(caminho_completo) então
            _listar_rec(base, caminho_item, resultado)
        fim
    fim
fim

função remover_diretorio recebendo caminho
    devolva servico_nativo("ARQUIVOS", "REMOVER_DIRETORIO", caminho)
fim

