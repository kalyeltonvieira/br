explicacao
    Geolocalização: coordenadas, distâncias (Haversine), CEP,
    estados, cidades brasileiras, fuso horário e utilidades geográficas.
    Biblioteca padrão da linguagem BR.
fim

função nome devolva "geolocalizacao" fim
função descricao devolva "Geolocalização: coordenadas, distância CEP e Brasil" fim
função versao devolva "1.0.0" fim

constante RAIO_TERRA_KM é 6371
constante RAIO_TERRA_MILHAS é 3959

# ============ DISTÂNCIA (HAVERSINE) ============

função distancia_km recebendo lat1, lon1, lat2 e lon2
    dlat é para_radianos(lat2 - lat1)
    dlon é para_radianos(lon2 - lon1)
    a é seno(dlat/2) * seno(dlat/2) + cosseno(para_radianos(lat1)) * cosseno(para_radianos(lat2)) * seno(dlon/2) * seno(dlon/2)
    c é 2 * arco_tangente(raiz_quadrada(a), raiz_quadrada(1-a))
    devolva RAIO_TERRA_KM * c
fim

função distancia_milhas recebendo lat1, lon1, lat2, lon2
    dlat é para_radianos(lat2 - lat1)
    dlon é para_radianos(lon2 - lon1)
    a é seno(dlat/2) * seno(dlat/2) + cosseno(para_radianos(lat1)) * cosseno(para_radianos(lat2)) * seno(dlon/2) * seno(dlon/2)
    c é 2 * arco_tangente(raiz_quadrada(a), raiz_quadrada(1-a))
    devolva RAIO_TERRA_MILHAS * c
fim

função para_radianos recebendo graus
    devolva graus * 3.141592653589793 / 180
fim

função arco_tangente recebendo y, x
    se x > 0 então devolva arco_tangente_valor(y / x) fim
    se x < 0 então
        se y >= 0 então devolva arco_tangente_valor(y / x) + 3.141592653589793 fim
        se y < 0 então devolva arco_tangente_valor(y / x) - 3.141592653589793 fim
    fim
    se y > 0 então devolva 3.141592653589793 / 2 fim
    se y < 0 então devolva -3.141592653589793 / 2 fim
    devolva 0
fim

função arco_tangente_valor recebendo x
    resultado é x
    termo é x
    repita 15 vezes
        n é contador
        termo é -termo * x * x
        resultado é resultado + termo / (2*n+3)
    fim
    devolva resultado
fim

função ponto_central recebendo coordenadas
    x_total é 0; y_total é 0; z_total é 0
    n é tamanho(coordenadas)
    
    para cada coord em coordenadas
        lat_rad é para_radianos(coord.latitude)
        lon_rad é para_radianos(coord.longitude)
        x_total é x_total + cosseno(lat_rad) * cosseno(lon_rad)
        y_total é y_total + cosseno(lat_rad) * seno(lon_rad)
        z_total é z_total + seno(lat_rad)
    fim
    
    x_medio é x_total / n; y_medio é y_total / n; z_medio é z_total / n
    lon_central é arco_tangente_valor(y_medio, x_medio)
    lat_central é arco_tangente_valor(z_medio, raiz_quadrada(x_medio*x_medio + y_medio*y_medio))
    
    devolva registro latitude: lat_central * 180 / 3.141592653589793 longitude: lon_central * 180 / 3.141592653589793 fim
fim

# ============ ESTADOS BRASILEIROS ============

função estados_brasil
    devolva [
        registro sigla: "AC" nome: "Acre" capital: "Rio Branco" regiao: "Norte" fim
        registro sigla: "AL" nome: "Alagoas" capital: "Maceió" regiao: "Nordeste" fim
        registro sigla: "AP" nome: "Amapá" capital: "Macapá" regiao: "Norte" fim
        registro sigla: "AM" nome: "Amazonas" capital: "Manaus" regiao: "Norte" fim
        registro sigla: "BA" nome: "Bahia" capital: "Salvador" regiao: "Nordeste" fim
        registro sigla: "CE" nome: "Ceará" capital: "Fortaleza" regiao: "Nordeste" fim
        registro sigla: "DF" nome: "Distrito Federal" capital: "Brasília" regiao: "Centro-Oeste" fim
        registro sigla: "ES" nome: "Espírito Santo" capital: "Vitória" regiao: "Sudeste" fim
        registro sigla: "GO" nome: "Goiás" capital: "Goiânia" regiao: "Centro-Oeste" fim
        registro sigla: "MA" nome: "Maranhão" capital: "São Luís" regiao: "Nordeste" fim
        registro sigla: "MT" nome: "Mato Grosso" capital: "Cuiabá" regiao: "Centro-Oeste" fim
        registro sigla: "MS" nome: "Mato Grosso do Sul" capital: "Campo Grande" regiao: "Centro-Oeste" fim
        registro sigla: "MG" nome: "Minas Gerais" capital: "Belo Horizonte" regiao: "Sudeste" fim
        registro sigla: "PA" nome: "Pará" capital: "Belém" regiao: "Norte" fim
        registro sigla: "PB" nome: "Paraíba" capital: "João Pessoa" regiao: "Nordeste" fim
        registro sigla: "PR" nome: "Paraná" capital: "Curitiba" regiao: "Sul" fim
        registro sigla: "PE" nome: "Pernambuco" capital: "Recife" regiao: "Nordeste" fim
        registro sigla: "PI" nome: "Piauí" capital: "Teresina" regiao: "Nordeste" fim
        registro sigla: "RJ" nome: "Rio de Janeiro" capital: "Rio de Janeiro" regiao: "Sudeste" fim
        registro sigla: "RN" nome: "Rio Grande do Norte" capital: "Natal" regiao: "Nordeste" fim
        registro sigla: "RS" nome: "Rio Grande do Sul" capital: "Porto Alegre" regiao: "Sul" fim
        registro sigla: "RO" nome: "Rondônia" capital: "Porto Velho" regiao: "Norte" fim
        registro sigla: "RR" nome: "Roraima" capital: "Boa Vista" regiao: "Norte" fim
        registro sigla: "SC" nome: "Santa Catarina" capital: "Florianópolis" regiao: "Sul" fim
        registro sigla: "SP" nome: "São Paulo" capital: "São Paulo" regiao: "Sudeste" fim
        registro sigla: "SE" nome: "Sergipe" capital: "Aracaju" regiao: "Nordeste" fim
        registro sigla: "TO" nome: "Tocantins" capital: "Palmas" regiao: "Norte" fim
    ]
fim

função estado_por_sigla recebendo sigla
    estados é estados_brasil()
    para cada est em estados
        se est.sigla igual sigla então devolva est fim
    fim
    devolva nulo
fim

função estado_por_nome recebendo nome
    estados é estados_brasil()
    para cada est em estados
        se est.nome igual nome então devolva est fim
    fim
    devolva nulo
fim

função regiao_por_sigla recebendo sigla
    estado é estado_por_sigla(sigla)
    se estado nulo então devolva "" fim
    devolva estado.regiao
fim

função estados_por_regiao recebendo regiao
    resultado é []
    estados é estados_brasil()
    para cada est em estados
        se est.regiao igual regiao então adicione est a resultado fim
    fim
    devolva resultado
fim

