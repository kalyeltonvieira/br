teste "distancia SP-Rio"
    # São Paulo e Rio de Janeiro
    distancia é distancia_km(-23.5505, -46.6333, -22.9068, -43.1729)
    esporte distancia >= 350 e distancia <= 450
fim

teste "estado por sigla"
    sp é estado_por_sigla("SP")
    esporte sp.nome igual a "São Paulo"
    esporte sp.capital igual a "São Paulo"
    esporte sp.regiao igual a "Sudeste"
fim

teste "estados por regiao"
    sul é estados_por_regiao("Sul")
    esporte tamanho(sul) igual a 3
fim

teste "ddd sp"
    estado_ddd é ddd_estado(11)
    esporte estado_ddd igual a "SP"
fim

teste "ddd rj"
    estado_ddd é ddd_estado(21)
    esporte estado_ddd igual a "RJ"
fim