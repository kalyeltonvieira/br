explicacao
    Matemática: funções matemáticas avançadas incluindo trigonometria,
    estatística, álgebra linear, números aleatórios e operações financeiras.
    Implementa algoritmos numéricos como Newton-Raphson, série de Taylor.
    Biblioteca padrão da linguagem BR.
fim

função nome
    devolva "matematica"
fim

função descricao
    devolva "Matemática avançada: trigonometria, estatística, álgebra, finanças"
fim

função versao
    devolva "1.0.0"
fim

constante PI é 3.141592653589793
constante E é 2.718281828459045

# ============ OPERAÇÕES BÁSICAS ============

função somar recebendo a e b
    devolva a + b
fim

função subtrair recebendo a e b
    devolva a - b
fim

função multiplicar recebendo a e b
    devolva a * b
fim

função dividir recebendo a e b
    se b igual 0 então
        devolva erro "Divisão por zero não permitida"
    fim
    devolva a / b
fim

função resto recebendo a e b
    devolva a % b
fim

função potencia recebendo base e expoente
    se expoente igual 0 então
        devolva 1
    fim
    resultado é 1
    repita abs(expoente) vezes
        resultado é resultado * base
    fim
    se expoente < 0 então
        devolva 1 / resultado
    fim
    devolva resultado
fim

função raiz_quadrada recebendo valor
    se valor < 0 então
        devolva erro "Raiz quadrada de número negativo"
    fim
    se valor igual 0 então
        devolva 0
    fim
    aproximacao é valor / 2
    repita 15 vezes
        aproximacao é (aproximacao + valor / aproximacao) / 2
    fim
    devolva aproximacao
fim

função raiz_cubica recebendo valor
    se valor igual 0 então
        devolva 0
    fim
    sinal é 1 se valor >= 0 senao -1
    valor_abs é valor * sinal
    resultado é sinal * potencia(valor_abs, 1/3)
    devolva resultado
fim

# ============ TRIGONOMETRIA ============

função pi
    devolva PI
fim

função para_radianos recebendo graus
    devolva graus * PI / 180
fim

função para_graus recebendo radianos
    devolva radianos * 180 / PI
fim

função seno recebendo x
    x_rad é x se x < 2 * PI senao x % (2 * PI)
    resultado é x_rad
    termo é x_rad
    repita 15 vezes
        n é 2 * contador + 1
        termo é -termo * x_rad * x_rad / ((2*n) * (2*n+1))
        resultado é resultado + termo
    fim
    devolva resultado
fim

função cosseno recebendo x
    devolva seno(PI/2 - x)
fim

função tangente recebendo x
    cos_x é cosseno(x)
    se cos_x < 0.00001 e cos_x > -0.00001 então
        devolva erro "Tangente indefinida"
    fim
    devolva seno(x) / cos_x
fim

função arco_seno recebendo x
    se x < -1 ou x > 1 então
        devolva erro "Arco-seno fora do domínio [-1, 1]"
    fim
    resultado é x
    termo é x
    repita 15 vezes
        n é contador
        termo é termo * x * x * (2*n+1) / (2*n+2)
        resultado é resultado + termo / (2*n+3)
    fim
    devolva resultado
fim

função arco_cosseno recebendo x
    devolva PI/2 - arco_seno(x)
fim

função arco_tangente recebendo x
    resultado é x
    termo é x
    repita 15 vezes
        n é contador
        termo é -termo * x * x
        resultado é resultado + termo / (2*n+3)
    fim
    devolva resultado
fim

# ============ LOGARITMOS ============

função logaritmo_natural recebendo x
    se x <= 0 então
        devolva erro "Logaritmo indefinido para x <= 0"
    fim
    y é (x - 1) / (x + 1)
    resultado é y
    termo é y
    repita 15 vezes
        n é contador
        termo é termo * y * y
        resultado é resultado + termo / (2*n+3)
    fim
    devolva 2 * resultado
fim

função logaritmo_base_10 recebendo x
    devolva logaritmo_natural(x) / logaritmo_natural(10)
fim

função logaritmo recebendo x e base
    se base igual 10 então
        devolva logaritmo_base_10(x)
    senao se base igual E ou base igual 2.718281828459045 então
        devolva logaritmo_natural(x)
    fim
    devolva logaritmo_natural(x) / logaritmo_natural(base)
fim

função exponencial recebendo x
    resultado é 1
    termo é 1
    repita 20 vezes
        n é contador + 1
        termo é termo * x / n
        resultado é resultado + termo
    fim
    devolva resultado
fim

# ============ FUNÇÕES HIPERBÓLICAS ============

função seno_hiperbolico recebendo x
    devolva (exponencial(x) - exponencial(-x)) / 2
fim

função cosseno_hiperbolico recebendo x
    devolva (exponencial(x) + exponencial(-x)) / 2
fim

função tangente_hiperbolico recebendo x
    e2x é exponencial(2*x)
    devolva (e2x - 1) / (e2x + 1)
fim

# ============ NÚMEROS ALEATÓRIOS ============

semente_aleatoria é 123456789
constante M_LCG é 2147483647
constante A_LCG é 48271
constante Q_LCG é 44488
constante R_LCG é 3399

função _proximo_aleatorio
    t é A_LCG * (semente_aleatoria % Q_LCG) - R_LCG * (semente_aleatoria / Q_LCG)
    se t > 0 então
        semente_aleatoria é t
    senao
        semente_aleatoria é t + M_LCG
    fim
    devolva semente_aleatoria / M_LCG
fim

função aleatorio
    devolva _proximo_aleatorio()
fim

função aleatorio_entre recebendo minimo e maximo
    devolva minimo + _proximo_aleatorio() * (maximo - minimo)
fim

função inteiro_aleatorio recebendo minimo e maximo
    se minimo nulo então minimo é 0 fim
    se maximo nulo então maximo é 100 fim
    devolva minimo + floor(_proximo_aleatorio() * (maximo - minimo + 1))
fim

função definir_semente recebendo nova_semente
    semente_aleatoria é nova_semente % M_LCG
    devolva verdadeiro
fim

função escolher_aleatorio recebendo lista
    se tamanho(lista) igual 0 então
        devolva nulo
    fim
    indice é inteiro_aleatorio(0, tamanho(lista) - 1)
    devolva lista[indice]
fim

# ============ ESTATÍSTICA ============

função media recebendo lista
    se tamanho(lista) igual 0 então
        devolva erro "Lista vazia"
    fim
    soma é 0
    para cada n em lista
        soma é soma + n
    fim
    devolva soma / tamanho(lista)
fim

função mediana recebendo lista
    n é tamanho(lista)
    se n igual 0 então
        devolva erro "Lista vazia"
    fim
    ordenados é []
    para cada item em lista
        adicione item a ordenados
    fim
    _ordenar_lista(ordenados)
    meio é n / 2
    se n % 2 igual 0 então
        devolva (ordenados[meio-1] + ordenados[meio]) / 2
    senao
        devolva ordenados[meio]
    fim
fim

função _ordenar_lista recebendo lista
    n é tamanho(lista)
    i é 0
    enquanto i < n
        j é 0
        enquanto j < n - i - 1
            se lista[j] > lista[j+1] então
                temp é lista[j]
                lista[j] é lista[j+1]
                lista[j+1] é temp
            fim
            j é j + 1
        fim
        i é i + 1
    fim
fim

função moda recebendo lista
    freq é registro
    max_freq é 0
    resultado é []
    para cada item em lista
        chave é "" + item
        freq[chave] é (freq[chave] se chave em freq senao 0) + 1
        se freq[chave] > max_freq então
            max_freq é freq[chave]
        fim
    fim
    para cada chave, valor em freq
        se valor igual max_freq então
            adicione chave como inteiro a resultado
        fim
    fim
    devolva resultado
fim

função variancia recebendo lista
    n é tamanho(lista)
    se n < 2 então
        devolva 0
    fim
    m é media(lista)
    soma_quad é 0
    para cada item em lista
        d é item - m
        soma_quad é soma_quad + d * d
    fim
    devolva soma_quad / (n - 1)
fim

função desvio_padrao recebendo lista
    devolva raiz_quadrada(variancia(lista))
fim

função minimo recebendo lista
    se tamanho(lista) igual 0 então
        devolva erro "Lista vazia"
    fim
    min_val é lista[0]
    para cada item em lista
        se item < min_val então
            min_val é item
        fim
    fim
    devolva min_val
fim

função maximo recebendo lista
    se tamanho(lista) igual 0 então
        devolva erro "Lista vazia"
    fim
    max_val é lista[0]
    para cada item em lista
        se item > max_val então
            max_val é item
        fim
    fim
    devolva max_val
fim

função soma_lista recebendo lista
    total é 0
    para cada item em lista
        total é total + item
    fim
    devolva total
fim

função produto_lista recebendo lista
    total é 1
    para cada item em lista
        total é total * item
    fim
    devolva total
fim

# ============ FUNÇÕES NUMÉRICAS ============

função absoluto recebendo x
    se x < 0 então devolva -x senao devolva x fim
fim

função abs recebendo x
    devolva absoluto(x)
fim

função floor recebendo x
    inteiro é x como inteiro
    se x < 0 e x diferente inteiro então
        devolva inteiro - 1
    fim
    devolva inteiro
fim

função teto recebendo x
    inteiro é x como inteiro
    se x > inteiro então
        devolva inteiro + 1
    fim
    devolva inteiro
fim

função arredondar recebendo x e casas
    se casas nulo então casas é 0 fim
    fator é potencia(10, casas)
    sinal é 1 se x >= 0 senao -1
    devolva sinal * floor(abs(x) * fator + 0.5) / fator
fim

função truncar recebendo x
    devolva x como inteiro
fim

função sinal recebendo x
    se x > 0 então devolva 1
    senao se x < 0 então devolva -1
    senao devolva 0
    fim
fim

função fracao recebendo x
    inteiro é x como inteiro
    devolva x - inteiro
fim

função clamp recebendo x, min_val, max_val
    se x < min_val então devolva min_val fim
    se x > max_val então devolva max_val fim
    devolva x
fim

# ============ TESTES ============

teste "seno de 0"
    esporte seno(0) < 0.0001
fim

teste "cosseno de 0"
    esporte abs(cosseno(0) - 1) < 0.0001
fim

teste "raiz quadrada"
    esporte raiz_quadrada(9) igual a 3 ou abs(raiz_quadrada(9) - 3) < 0.001
fim

teste "media"
    lista é [1, 2, 3, 4, 5]
    esporte media(lista) igual a 3
fim

teste "mediana impar"
    lista é [3, 1, 2]
    esporte mediana(lista) igual a 2
fim

teste "desvio padrao"
    lista é [1, 2, 3]
    desv é desvio_padrao(lista)
    esporte desv > 0
fim

teste "arredondar"
    esporte arredondar(3.14159, 2) igual a 3.14
fim

teste "minimo e maximo"
    lista é [5, 2, 8, 1, 9]
    esporte minimo(lista) igual a 1
    esporte maximo(lista) igual a 9
fim

teste "potencia"
    esporte potencia(2, 3) igual a 8
    esporte potencia(5, 0) igual a 1
fim

teste "absoluto"
    esporte absoluto(-5) igual a 5
    esporte absoluto(3) igual a 3
fim

teste "clamp"
    esporte clamp(10, 0, 5) igual a 5
    esporte clamp(-5, 0, 10) igual a 0
    esporte clamp(3, 0, 10) igual a 3
fim